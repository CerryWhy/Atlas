{
  "name": "atlas",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/run-venv.mjs uvicorn api.main:app --reload --reload-dir api --port 8000",
    "dev:web": "npm --prefix web run dev",
    "pipeline:phase0": "node scripts/run-venv.mjs python -m pipeline.phase0_tracer",
    "gen:types": "npm --prefix web run gen:types"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "concurrently": "9.2.5"
  }
}
